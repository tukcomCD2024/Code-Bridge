<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rectangle_white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="30dp"
        android:padding="1dp">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="현재 Organization"
            android:textColor="@color/black"
            android:textSize="20dp"/>

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/baseline_groups_24"
            android:layout_marginTop="20dp"
            android:background="@color/yellow"
            android:layout_below="@+id/textView1"
            android:layout_centerHorizontal="true"/>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@drawable/dotted_line" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginLeft="10dp">

        <ImageView
            android:id="@+id/post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_post"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="멤버 초대하기"
            android:textColor="@color/black"
            android:textSize="15dp"
            android:layout_marginLeft="3dp"
            android:layout_toRightOf="@+id/post"/>

        <TextView
            android:id="@+id/inviteText"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:background="@drawable/rectangle_white"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/post"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/inviteEditText"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="12dp"
            android:layout_below="@+id/post"
            android:background="@android:color/transparent"
            android:hint="초대하려는 유저의 이메일을 입력하세요."
            android:textSize="16sp" />

        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_toRightOf="@id/inviteEditText"
            android:layout_below="@+id/post"
            android:text="보내기"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/rectangle_blue"/>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_square"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="멤버 목록 (n명)"
            android:textColor="@color/black"
            android:textSize="15dp"
            android:layout_marginLeft="3dp"
            android:layout_toRightOf="@+id/image"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/rectangle_white"
            android:padding="15dp"
            android:layout_below="@+id/image"/>

    </RelativeLayout>


</LinearLayout>