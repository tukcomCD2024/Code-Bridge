<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="5dp">


    <RelativeLayout
        android:id="@+id/mainHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/rectangle_dodgerblue"
        android:elevation="4dp"
        android:padding="15dp">

        <TextView
            android:id="@+id/sharenote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="Sharenote"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"/>

        <ImageButton
            android:id="@+id/menuBtn"
            android:layout_width="40dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:background="#0fff"
            android:scaleType="fitXY"
            android:src="@drawable/baseline_list_24_white" />

        <RelativeLayout
            android:id="@+id/profileForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/sharenote"
            android:layout_marginTop="15dp"
            android:layout_toStartOf="@id/menuBtn"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/baseline_groups_24"
                android:background="@drawable/rectangle_white"/>

            <RelativeLayout
                android:id="@+id/profileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/profileImage"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/workSpaceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="워크스페이스"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/emailtextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/workSpaceText"
                    android:layout_marginLeft="10dp"
                    android:text="이메일"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/mainHead">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

            <RelativeLayout
                android:id="@+id/quiz"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:elevation="6dp"
                android:background="@drawable/rectangle_link"
                app:layout_constraintEnd_toStartOf="@+id/contribution"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="10dp">

                <TextView
                    android:id="@+id/qtext1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="팀원끼리 문제를\n풀어보세요!"
                    android:textColor="@color/dimgray"
                    android:padding="10dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp">

                    <TextView
                        android:id="@+id/lightbulb"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/lightbulb"/>

                    <TextView
                        android:id="@+id/qtext2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="퀴즈"
                        android:textSize="22dp"
                        android:textColor="@color/black"
                        android:layout_centerVertical="true"
                        android:textStyle="bold"
                        android:layout_toRightOf="@id/lightbulb"/>

                </RelativeLayout>



        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/contribution"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="10dp"
            android:elevation="6dp"
            android:background="@drawable/rectangle_link"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/quiz"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="10dp">

            <TextView
                android:id="@+id/ctext1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자신의 참여도를\n확인해보세요!"
                android:textColor="@color/dimgray"
                android:padding="10dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp">

                <TextView
                    android:id="@+id/chart"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/chart"/>

                <TextView
                    android:id="@+id/ctext2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기여도"
                    android:textSize="22dp"
                    android:textColor="@color/black"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:textStyle="bold"
                    android:layout_toRightOf="@id/chart"/>

            </RelativeLayout>

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <RelativeLayout
                android:id="@+id/bookText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_below="@id/link"
                android:background="@drawable/rectangle_lb"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/recent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:text="최근 방문한 노트"
                    android:textColor="#000"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="최근 방문한 노트를 표시합니다."
                    android:textColor="@color/dimgray"
                    android:layout_below="@id/recent"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="10dp" />

            </RelativeLayout>

            <FrameLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/bookText"
                android:layout_marginBottom="20dp"
                android:padding="1dp" >

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewRecentNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="vertical"/>

                <RelativeLayout
                    android:id="@+id/noRecentNotesLayout"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:background="@drawable/rounded_divider"/>

                    <ImageView
                        android:id="@+id/image"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="5dp"
                        android:src="@drawable/ic_bookmark"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="70dp"
                        android:layout_below="@+id/image"
                        android:maxLines="2"
                        android:text="모바일에서 시작하기"
                        android:textColor="#000"
                        android:textSize="14sp" />
                </RelativeLayout>
            </FrameLayout>

            <RelativeLayout
                android:id="@+id/teamText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/list"
                android:layout_marginVertical="10dp"
                android:background="@drawable/rectangle_lb"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/notelist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:text="노트 목록"
                    android:textColor="#000"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="보유한 노트를 표시합니다."
                    android:textColor="@color/dimgray"
                    android:layout_below="@id/notelist"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="10dp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/listLayout"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_below="@+id/teamText"
                android:padding="1dp">

                <ImageView
                    android:id="@+id/listLayout_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_keyboard_arrow_down_24"/>

                <ImageView
                    android:id="@+id/listLayout_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:layout_toRightOf="@id/listLayout_1"
                    android:src="@drawable/ic_home"/>

                <TextView
                    android:id="@+id/listLayout_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="5dp"
                    android:layout_toRightOf="@id/listLayout_2"
                    android:text="전체"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_margin="8dp"/>

                <ImageView
                    android:id="@+id/listLayout_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/baseline_add_24"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="16dp"
                android:layout_below="@+id/listLayout"/>
        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
